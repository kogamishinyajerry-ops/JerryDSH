  "cards": [
    {
      "dot": "cyan",
      "title": "研究线底座（01–11）",
      "items": [
        "会话事件日志是唯一真源，其余全是投影与小抄",
        "『模型可见即已记录』是运行时断言的不变量",
        "能力 seam 三件套：定义 / 提供方 / 消费方，换提供方即换行为"
      ]
    },
    {
      "dot": "emerald",
      "title": "本机实测数字",
      "items": [
        "310 本日记全量导入零错误 · 工具调用 1.7 万次（run_code 3453 居首）",
        "缓存读 3.4G token vs 未缓存输入 96M —— KV cache 价值 35 倍",
        "模型画像：glm-5.3 9365 次 · deepseek-v4-pro 2502 · MiniMax-M3 2263"
      ]
    },
    {
      "dot": "violet",
      "title": "省钱与加速机制",
      "items": [
        "KV 缓存纪律：只往后加不往前改，时变内容做成便利贴",
        "压缩先跑无模型修剪再请模型摘要；遮住 ≠ 删除，历史永远可搜",
        "全文检索 FTS 默认关闭（openAt: never）——先开官方再考虑插件"
      ]
    },
    {
      "dot": "rose",
      "title": "安全大实话",
      "items": [
        "审批 fail-closed：允许这一次 / 拒绝 / 撤销 / 没人回答=拒绝",
        "沙箱只管文件不管网络；部分强制（partial）必须当失败处理",
        "装插件 = 在一切沙箱之外执行第三方代码：先源码体检、锁定版本"
      ]
    },
    {
      "dot": "amber",
      "title": "版本与生态",
      "items": [
        "8 月节奏：9 天 5 版后进入静默期（三源一致核查法 30 秒）",
        "凭证格式换代是单向门：rc.5 惨案——别停在断代点",
        "三个装插件著名的坑：dist-tag 错位 / pnpm 构建拦截 / 网页专用插件"
      ]
    }
  ]
