  "cards": [
    { "id": "t-grill", "use": "开工前说\"拷问我这个想法\"；agent 一轮问完整个前沿，每题带推荐答案", "essence": "把\"猜\"变成\"问\"：设计树走完，前沿为空才动手", "first": "公理三：模型会静默填空，猜与选不可分辨——唯一解法是把决策显式摆给人" },
    { "id": "t-proto", "use": "纸面上定不了的问题（手感/外观）→ 一次性原型答一个问题", "essence": "对话分辨率不够时，造便宜的真物来反应", "first": "公理四：有些知识只能从运行中来；可运行物是最高分辨率的语言" },
    { "id": "t-spec", "use": "拷问完说\"落成 spec 和工单\"；垂直切片+阻塞边，一票一个 smart zone", "essence": "spec/工单是无状态模型的记忆假肢：会话可弃，交接物长存", "first": "公理一：会话清零——一切跨会话价值必须外化到环境" },
    { "id": "t-impl", "use": "逐票新会话实现；驱动 eng-tdd：先约 seam，再 red→green", "essence": "反馈速率是速度上限：一失败测试→恰好过→下一片", "first": "公理四+六：模型只见窗口且非确定——只有独立真值能锚住行为" },
    { "id": "t-review", "use": "implement 收尾自动触发；两轴并行子代理，报告并排不合并", "essence": "\"规范全对但做错了\"与\"做对了但破坏约定\"必须分开看", "first": "公理三+六：附和倾向+非确定 → 验证者与生产者必须隔离" },
    { "id": "t-domain", "use": "讨论中术语一结晶就写进 CONTEXT.md；难逆决策过三条件记 ADR", "essence": "共享语言是注意力的压缩器：materialization cascade 一个词顶一句话", "first": "公理二：注意力按 token 封顶——语言越精炼，同一预算装越多工程" },
    { "id": "t-design", "use": "设计接口时按词汇表说话；加深机会过删除测试", "essence": "大量行为藏在小接口后：深=杠杆+局部性", "first": "公理五：生成放大熵——只有深模块能把复杂度关回笼子" },
    { "id": "t-diag", "use": "疑难 bug 交给它：先造对本 bug 会红的回路，再假设、插桩、修复", "essence": "回路是 90%：没有能红的命令，就没有假设阶段", "first": "公理四：模型会自信地编——只有可重复的红色信号是真值" },
    { "id": "t-writing", "use": "写 AGENTS.md/技能时自动加载；指针措辞前置触发词", "essence": "上下文是双重成本：指针一行，内联千金", "first": "公理二：每个常驻 token 每轮付费且花注意力——渐进披露是经济学必然" },
    { "id": "t-hygiene", "use": "阶段边界上按五问决策树换挡：Continue→清→交接→子代理→压缩", "essence": "smart zone 是预算不是窗口上限：质量在满之前就开始掉", "first": "公理二：注意力衰减无报错无边界——只能在边界主动管理" },
    { "id": "t-wayfinder", "use": "工程大到装不下时说\"画张地图\"；决策票一次解决一张", "essence": "规划不是执行：产出决策，不是交付物", "first": "公理一+三：大工程的未定决策太多——先消灭不确定性再消耗实现预算" },
    { "id": "t-arch", "use": "空档时说\"巡检架构\"；spec 驱动可验证 HTML 报告，挑一个回主流", "essence": "盘点不是施工：每天投资设计，对抗熵增", "first": "公理五：熵不休假——加深是唯一让未来变更变便宜的杠杆" },
    { "id": "t-wizard", "use": "agent 撞上只有人能过的墙时自动生成向导脚本", "essence": "人机分工的接口工程：重复解释不如一次落成脚本", "first": "公理四：世界有一半只有人能走进——把那条路铺成可重走的台阶" }
